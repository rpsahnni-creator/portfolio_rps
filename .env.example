# Used by docker-compose.yml for the whole stack (copy to ".env" at the repo root)

POSTGRES_DB=rps_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

JWT_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
OWNER_EMAIL=owner@example.com

SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
EMAIL_FROM_NAME=Ram Pravesh Sahni
EMAIL_REPLY_TO=

# Same domain (recommended): leave empty. Separate domains: set to the API's URL.
REACT_APP_BACKEND_URL=
# Must match the domain(s) the frontend is served from.
CORS_ORIGINS=http://localhost
