# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rps_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Outgoing email (SMTP) ----
# Any SMTP provider works: AWS SES SMTP, Gmail (app password), SendGrid, Mailgun, etc.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

EMAIL_FROM_NAME=Ram Pravesh Sahni
EMAIL_REPLY_TO=
OWNER_EMAIL=owner@example.com

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ---- AI Chatbot ----
# Set at least one provider key below. CHAT_PROVIDER picks which one to use when more than
# one key is set (anthropic | openai | gemini); otherwise the first configured key wins.
CHAT_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-3.5-flash
